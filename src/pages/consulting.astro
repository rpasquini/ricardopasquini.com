---
import Layout from "../layouts/Layout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Ricardo A. Pasquini — Independent consulting (Beta Sigma)",
  url: "https://ricardopasquini.com/consulting/",
  provider: { "@type": "Person", name: "Ricardo A. Pasquini" },
  audience: "Forensic economists and international arbitration teams",
  email: "rpasquini@betasigma.tech",
};
---
<Layout
  title="Consulting"
  description="Independent econometrics and data work for forensic economists and arbitration teams: causal and but-for support, evidence structuring, geospatial analysis, and reproducible pipelines."
  jsonLd={jsonLd}
>
  <div class="consulting">
    <h1>Consulting</h1>
    <p class="consulting-lede">
      Alongside my academic work, I work independently with forensic economists and arbitration
      teams that need rigorous, defensible data work, without building it in-house. See
      <a href="https://betasigma.tech">Beta Sigma</a>, my consulting vehicle, for further reference.
    </p>

    <p class="section-label">Related writing</p>
    <ul class="home-list">
      <li>
        <a href="/causal-inference-in-the-courtroom-first-results-from-a-systematic-review/">
          Causal Inference in the Courtroom: First Results from a Systematic Review
        </a>
      </li>
    </ul>

    <p class="section-label" id="contact">Contact</p>
    <p>
      Email <a href="mailto:rpasquini@betasigma.tech">rpasquini@betasigma.tech</a>. Replies typically
      come within 24 hours.
    </p>
  </div>
</Layout>
